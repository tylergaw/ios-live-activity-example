{
  "name": "study-timer",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo/cli": "57.0.10",
    "expo": "57.0.8",
    "expo-dev-client": "57.0.9",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.8.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "eslint": "9.27.0",
    "eslint-config-expo": "9.0.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.4.1",
    "prettier": "3.5.3",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "expo prebuild --platform ios --clean",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{ts,tsx,js,json}' --ignore-path .gitignore",
    "format:check": "prettier --check '**/*.{ts,tsx,js,json}' --ignore-path .gitignore"
  },
  "private": true,
  "pnpm": {
    "patchedDependencies": {
      "expo-modules-jsi": "patches/expo-modules-jsi.patch"
    }
  }
}
